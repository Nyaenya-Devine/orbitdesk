{
  "name": "orbitdesk",
  "version": "2.0.0",
  "private": true,
  "description": "Modern Workplace Operations Lab — MSP Team Lead Simulator with real voice calls, remote PC access, tech experts conference, desktop installable",
  "author": "Devine Nyaenya <devinenyaenya@gmail.com>",
  "homepage": "https://github.com/Nyaenya-Devine/orbitdesk",
  "main": "electron.js",
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop": "electron .",
    "desktop:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "next build && next export || echo 'Export skipped for Next 16, using build'",
    "desktop:dist": "npm run build && electron-builder --publish=never",
    "desktop:dist:win": "electron-builder --win --publish=never",
    "desktop:dist:mac": "electron-builder --mac --publish=never",
    "desktop:dist:linux": "electron-builder --linux --publish=never",
    "pwa:build": "next build",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "next": "16.3.5",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.orbitdesk.lab",
    "productName": "OrbitDesk",
    "copyright": "© 2026 OrbitDesk — Educational Simulator — MIT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "preload.js",
      "out/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "public/audio",
        "to": "audio",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon-512.png",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon-512.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  },
  "keywords": [
    "msp",
    "modern-workplace",
    "team-lead",
    "entra-id",
    "intune",
    "voice-calls",
    "remote-pc",
    "pwa",
    "electron",
    "desktop-app",
    "simulator"
  ]
}
